{
  "name": "acmecorp-aws-landing-zone",
  "version": "0.1.0",
  "description": "AWS Landing Zone for AcmeCorp (Merlin Studio v2)",
  "private": true,
  "bin": {
    "acmecorp": "bin/app.js"
  },
  "scripts": {
